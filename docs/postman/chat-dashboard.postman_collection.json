              "host": ["{{baseUrl}}"],
              "path": ["admin", "api", "v1", "conversations", "{{convId}}", "read"],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Mark unread",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/conversations/{{convId}}/unread",
