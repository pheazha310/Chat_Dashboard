Project Chat_Dashboard {
  database_type: 'PostgreSQL'
  Note: 'Two-backend architecture. Backend 1 tables are EXTERNAL documentation references only. Backend 2 tables are the actual Chat Database.'
}

// =====================================================
// BACKEND 1 — MAIN BUSINESS DATABASE (EXTERNAL)
// These tables are NOT created in the Chat Database.
// =====================================================

TableGroup Backend_1_External {
  users
  roles
  permissions
  user_roles
  role_permissions
  customers
  agents
  loan_applications
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'External ID from Backend 1']
  name varchar(150)
  email varchar(255)
  password_hash varchar(255) [note: 'Managed by Backend 1']
  status varchar(30)
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — owned by Backend 1'
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100)
  description text

  Note: 'EXTERNAL TABLE — owned by Backend 1'
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150)
  description text

  Note: 'EXTERNAL TABLE — owned by Backend 1'
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  role_id uuid [not null]

  indexes {
    (user_id, role_id) [unique]
  }

  Note: 'EXTERNAL TABLE — owned by Backend 1'
}

Table role_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [not null]
  permission_id uuid [not null]

  indexes {
    (role_id, permission_id) [unique]
  }

  Note: 'EXTERNAL TABLE — owned by Backend 1'
}

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  customer_code varchar(100)
  phone varchar(30)
  address text
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — customer profiles owned by Backend 1'
}

Table agents {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  employee_code varchar(100)
  department varchar(100)
  is_available boolean
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — agent profiles owned by Backend 1'
}

Table loan_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  application_number varchar(100)
  loan_type varchar(100)
  amount decimal(15,2)
  status varchar(50)
  submitted_at timestamptz
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — loan application data owned by Backend 1'
}

// =====================================================
// BACKEND 2 — CHAT DATABASE (ACTUAL TABLES)
// =====================================================

TableGroup Backend_2_Chat_Core {
  conversations
  conversation_participants
  conversation_assignments
  conversation_activities
}

Table conversations {
  id uuid [pk, default: `gen_random_uuid()`]

  // External references from Backend 1
  customer_id uuid [note: 'External customers.id. Required for CUSTOMER_SUPPORT, NULL for INTERNAL (CHECK)']
  application_id uuid [note: 'External loan_applications.id']

  customer_name varchar(150) [note: 'Snapshot of the Backend 1 customer name so the inbox can be searched and sorted in SQL (FR-07); refresh when Backend 1 reports a change']
  customer_identifier varchar(100) [note: 'Snapshot of a searchable identifier (customer_code, phone, application_number)']

  conversation_type varchar(30) [not null, default: 'CUSTOMER_SUPPORT']
  channel varchar(32) [not null, default: 'web', note: 'web or mobile']
  created_by_type varchar(30) [note: 'CUSTOMER or AGENT; NULL when created by the system']
  created_by_id uuid [note: 'External customers.id or agents.id; set exactly when created_by_type is set']
  status varchar(30) [not null, default: 'OPEN']
  priority varchar(20) [not null, default: 'MEDIUM']

  conversation_mode varchar(20) [not null, default: 'AI']
  handoff_status varchar(30) [not null, default: 'NONE']

  assigned_agent_id uuid [note: 'External agents.id. Denormalized current OWNER from conversation_assignments for fast Mine/Unassigned filters; set exactly when handoff_status = ASSIGNED (CHECK)']

  subject varchar(255)
  summary text

  is_archived boolean [not null, default: false]
  archived_at timestamptz
  resolved_at timestamptz
  closed_at timestamptz
  last_message_at timestamptz [not null, default: `now()`]
  last_message_preview varchar(255) [note: 'Denormalized; updated in the same transaction as the message insert']
  last_sequence_number bigint [not null, default: 0, note: 'Last messages.sequence_number issued. Allocate with UPDATE ... SET last_sequence_number = last_sequence_number + 1 RETURNING']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, last_message_at)
    customer_id
    application_id
    (priority, last_message_at)
    (assigned_agent_id, last_message_at)
    (is_archived, last_message_at)
    conversation_type
  }

  Note: 'CUSTOMER_SUPPORT or INTERNAL. Customer and application are external references.'
}

Table conversation_participants {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  participant_type varchar(30) [not null, note: 'CUSTOMER, AGENT, ASSISTANT']
  participant_id uuid [note: 'External customers.id or agents.id; NULL exactly when ASSISTANT (CHECK)']
  participant_role varchar(30) [not null, default: 'MEMBER', note: 'OWNER, VIEWER, MEMBER']

  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz

  indexes {
    conversation_id
    (participant_type, participant_id)
  }
}

Table conversation_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  agent_id uuid [not null, note: 'External agents.id']
  assigned_by uuid [note: 'External agents.id']

  assignment_type varchar(30) [not null, default: 'OWNER', note: 'OWNER or VIEWER']
  assignment_action varchar(30) [not null, default: 'ASSIGNED', note: 'TAKEOVER, ASSIGNED, TRANSFERRED, AUTO_ASSIGNED']
  note varchar(500)

  assigned_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  ended_by uuid [note: 'External agents.id; NULL when ended by the system']

  indexes {
    (conversation_id, ended_at)
    (agent_id, ended_at)
  }
}

Table conversation_activities {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  actor_type varchar(30) [not null]
  actor_id uuid [note: 'External actor ID; null for system']

  activity_type varchar(50) [not null]
  description text
  metadata jsonb

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
    (conversation_id, activity_type)
  }
}

// =====================================================
// MESSAGES
// =====================================================

TableGroup Backend_2_Messaging {
  messages
  message_receipts
  conversation_reads
  message_edit_history
  message_reactions
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  client_id varchar(100) [note: 'Client-generated ID for duplicate prevention']
  sequence_number bigint [not null]

  sender_type varchar(30) [not null, note: 'CUSTOMER, AGENT, ASSISTANT, SYSTEM']
  sender_id uuid [note: 'External sender ID, null for system']

  message_type varchar(30) [not null, default: 'TEXT']
  content text
  metadata jsonb [note: 'Payload for SYSTEM messages, e.g. who took over; call or callback references']

  reply_to_message_id uuid
  forwarded_from_message_id uuid

  status varchar(20) [not null, default: 'SENT', note: 'Sender-facing summary: SENDING, SENT, DELIVERED, READ, FAILED. Per-recipient detail is in message_receipts']

  is_edited boolean [not null, default: false]
  edited_at timestamptz
  deleted_at timestamptz
  deleted_by uuid [note: 'External agents.id']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, sequence_number) [unique]
    (conversation_id, client_id) [unique]
    (id, conversation_id) [unique]
    (conversation_id, created_at)
    (sender_type, sender_id)
    reply_to_message_id
    forwarded_from_message_id
  }
}

Table message_receipts {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  recipient_type varchar(30) [not null]
  recipient_id uuid [not null]

  delivered_at timestamptz
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, recipient_type, recipient_id) [unique]
    (recipient_type, recipient_id, read_at)
  }
}

Table conversation_reads {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  reader_type varchar(30) [not null]
  reader_id uuid [not null]

  last_read_message_id uuid
  last_read_sequence_number bigint [not null, default: 0, note: 'Unread count = conversations.last_sequence_number - this (approximate: includes own and system messages)']
  last_read_at timestamptz
  marked_unread boolean [not null, default: false, note: 'Agent manually marked the conversation unread (FR-05)']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, reader_type, reader_id) [unique]
    last_read_message_id
  }
}

Table message_edit_history {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  editor_type varchar(30) [not null]
  editor_id uuid [not null]

  previous_content text [not null]
  edited_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, edited_at)
  }
}

Table message_reactions {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  user_type varchar(30) [not null]
  user_id uuid [not null]

  emoji varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, user_type, user_id, emoji) [unique]
  }
}

// =====================================================
// ATTACHMENTS
// =====================================================

TableGroup Backend_2_Attachments {
  attachments
  message_attachments
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, note: 'Needed for the Media & Files panel and access control; an upload exists before its message']

  uploaded_by_type varchar(30) [not null]
  uploaded_by_id uuid [not null]

  storage_key varchar(500) [not null, unique]
  file_name varchar(255) [not null]
  mime_type varchar(150) [not null]
  file_size bigint [not null]
  duration_ms int [note: 'Audio, video and voice messages (FR-18)']
  waveform jsonb [note: 'Voice message amplitude samples']
  checksum_sha256 varchar(64)

  upload_status varchar(30) [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (conversation_id, created_at)
    (uploaded_by_type, uploaded_by_id)
    (upload_status, created_at)
    (id, conversation_id) [unique]
  }
}

Table message_attachments {
  message_id uuid [not null]
  attachment_id uuid [not null]
  conversation_id uuid [not null, note: 'Must match both the message and attachment conversation (composite foreign keys)']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, attachment_id) [pk]
    conversation_id
    attachment_id
  }
}

// =====================================================
// INTERNAL NOTES AND ESCALATIONS
// =====================================================

TableGroup Backend_2_Internal_Notes {
  internal_notes
  note_mentions
  conversation_escalations
}

Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  author_agent_id uuid [not null, note: 'External agents.id']
  content text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (conversation_id, created_at)
  }
}

Table note_mentions {
  id uuid [pk, default: `gen_random_uuid()`]
  note_id uuid [not null]
  mentioned_agent_id uuid [not null, note: 'External agents.id']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (note_id, mentioned_agent_id) [unique]
    mentioned_agent_id
  }
}

Table conversation_escalations {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  requested_by uuid [not null, note: 'External agents.id']
  reason text

  status varchar(30) [not null, default: 'PENDING']
  resolved_by uuid [note: 'External agents.id']

  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    (conversation_id, status)
  }
}

// =====================================================
// TAGS
// =====================================================

TableGroup Backend_2_Tags {
  tags
  conversation_tags
}

Table tags {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  color varchar(30)

  created_by uuid [note: 'External agents.id']
  created_at timestamptz [not null, default: `now()`]
}

Table conversation_tags {
  conversation_id uuid [not null]
  tag_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, tag_id) [pk]
    tag_id
  }
}

// =====================================================
// NOTIFICATIONS AND PRESENCE
// =====================================================

TableGroup Backend_2_Notifications {
  notifications
  notification_preferences
  conversation_notification_settings
  agent_presence_history
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]

  recipient_type varchar(30) [not null]
  recipient_id uuid [not null, note: 'External Backend 1 ID']

  conversation_id uuid
  message_id uuid

  notification_type varchar(50) [not null]
  title varchar(255) [not null]
  body text

  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_type, recipient_id, created_at)
    (recipient_type, recipient_id, read_at)
    conversation_id
    message_id
  }
}

Table notification_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, unique, note: 'External agents.id']

  new_message_enabled boolean [not null, default: true]
  assignment_enabled boolean [not null, default: true]
  transfer_enabled boolean [not null, default: true]
  mention_enabled boolean [not null, default: true]

  sound_enabled boolean [not null, default: true]
  browser_enabled boolean [not null, default: true]

  updated_at timestamptz [not null, default: `now()`]
}

Table conversation_notification_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]
  agent_id uuid [not null, note: 'External agents.id']

  is_muted boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, agent_id) [unique]
    agent_id
  }
}

Table agent_presence_history {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'External agents.id']

  status varchar(30) [not null, note: 'AVAILABLE, BUSY, AWAY, OFFLINE']

  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  indexes {
    (agent_id, ended_at)
  }

  Note: 'History only. Live presence (Available/Busy/Away/Offline) is kept in Redis.'
}

// =====================================================
// CANNED RESPONSES AND AUTOMATIONS
// =====================================================

TableGroup Backend_2_Automations {
  canned_responses
  automation_rules
  automation_logs
}

Table canned_responses {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  content text [not null]

  shortcut varchar(50) [note: 'e.g. /greeting']

  scope varchar(30) [not null, default: 'PERSONAL', note: 'PERSONAL, SHARED (everyone) or TEAM (unused until Backend 1 defines teams)']
  team_id uuid [note: 'External team id; set exactly when scope = TEAM (CHECK)']
  created_by uuid [not null, note: 'External agents.id']

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (created_by, is_active)
    (team_id, is_active)
  }
}

Table automation_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]

  trigger_type varchar(50) [not null]
  conditions jsonb
  response_content text [not null]

  priority int [not null, default: 0]
  is_active boolean [not null, default: true]

  created_by uuid [note: 'External agents.id']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, trigger_type, priority)
  }
}

Table automation_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  rule_id uuid [not null]
  conversation_id uuid [not null]
  message_id uuid

  execution_status varchar(30) [not null]
  error_message text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (rule_id, created_at)
    conversation_id
    message_id
  }
}

// =====================================================
// CALLBACKS AND CALLS
// =====================================================

TableGroup Backend_2_Calls {
  callback_requests
  calls
  call_participants
}

Table callback_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  customer_id uuid [not null, note: 'External customers.id']
  assigned_agent_id uuid [note: 'External agents.id']

  created_by uuid [note: 'External agents.id']

  scheduled_at timestamptz [not null]
  status varchar(30) [not null, default: 'PENDING']

  notes text
  completion_note text
  reminder_sent_at timestamptz [note: 'Set when the upcoming-callback notification was sent']

  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (assigned_agent_id, status, scheduled_at)
    (status, scheduled_at)
    conversation_id
    customer_id
  }
}

Table calls {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  initiated_by_type varchar(30) [not null]
  initiated_by_id uuid [not null]

  call_type varchar(20) [not null]
  status varchar(30) [not null, default: 'INITIATING']

  started_at timestamptz
  ended_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
  }

  Note: 'Signalling record and call history; media is not stored.'
}

Table call_participants {
  id uuid [pk, default: `gen_random_uuid()`]
  call_id uuid [not null]

  participant_type varchar(30) [not null]
  participant_id uuid [not null]

  joined_at timestamptz
  left_at timestamptz

  indexes {
    (call_id, participant_type, participant_id) [unique]
    (participant_type, participant_id)
  }
}

// =====================================================
// SPAM AND MODERATION
// =====================================================

TableGroup Backend_2_Moderation {
  spam_reports
  customer_blocks
  blocked_keywords
  moderation_activities
}

Table spam_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  reported_by_type varchar(30) [not null]
  reported_by_id uuid [not null]

  message_id uuid [note: 'The reported message, if any']

  reason text [not null]
  status varchar(30) [not null, default: 'PENDING']

  reviewed_by uuid [note: 'External agents.id']
  reviewed_at timestamptz
  resolution_note varchar(500)

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, created_at)
    conversation_id
    message_id
  }
}

Table customer_blocks {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null, note: 'External customers.id']
  blocked_by uuid [not null, note: 'External agents.id']

  reason text

  blocked_at timestamptz [not null, default: `now()`]
  unblocked_at timestamptz
  unblocked_by uuid [note: 'External agents.id']

  indexes {
    (customer_id, unblocked_at)
  }

  Note: 'One active block (unblocked_at IS NULL) per customer via a partial unique index.'
}

Table blocked_keywords {
  id uuid [pk, default: `gen_random_uuid()`]
  keyword varchar(255) [not null, unique]

  is_active boolean [not null, default: true]
  created_by uuid [note: 'External agents.id']

  created_at timestamptz [not null, default: `now()`]
}

Table moderation_activities {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [not null, note: 'External agents.id']

  action varchar(100) [not null]
  target_type varchar(50) [not null]
  target_id uuid [not null]

  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, created_at)
    (target_type, target_id)
  }
}

// =====================================================
// MOBILE AND WORKSPACE
// =====================================================

TableGroup Backend_2_Workspace {
  push_devices
  workspace_preferences
  workspace_open_conversations
  conversation_drafts
  user_chat_settings
}

Table push_devices {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'External users.id (every customer and agent has one)']

  platform varchar(30) [not null]
  device_token varchar(512) [not null]
  is_active boolean [not null, default: true]

  last_seen_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (platform, device_token) [unique]
    user_id
  }
}

Table workspace_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, unique, note: 'External agents.id']

  layout jsonb
  sidebar_width int
  settings jsonb

  updated_at timestamptz [not null, default: `now()`]
}

Table workspace_open_conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'External agents.id']
  conversation_id uuid [not null]

  sort_order int [not null, default: 0]
  last_opened_at timestamptz [not null, default: `now()`]

  indexes {
    (agent_id, conversation_id) [unique]
    conversation_id
  }
}

Table conversation_drafts {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'External agents.id']
  conversation_id uuid [not null]

  content text [not null, note: 'Unsent composer text, at most 10000 characters. An empty draft is deleted, not stored.']

  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (agent_id, conversation_id) [unique]
    conversation_id
  }
}

Table user_chat_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, note: 'External users.id']

  typing_sound_enabled boolean [not null, default: true]
  notification_sound_enabled boolean [not null, default: true]
  ai_suggestions_enabled boolean [not null, default: true]
  ai_summaries_enabled boolean [not null, default: true]
  auto_assign_enabled boolean [not null, default: false, note: 'Opt in to auto-assignment (only when authorized)']

  updated_at timestamptz [not null, default: `now()`]
}

// =====================================================
// BACKEND 1 — INTERNAL RELATIONSHIPS
// Conceptual relationships within Backend 1 only.
// =====================================================

Ref: users.id < user_roles.user_id
Ref: roles.id < user_roles.role_id
Ref: roles.id < role_permissions.role_id
Ref: permissions.id < role_permissions.permission_id
Ref: users.id - customers.user_id
Ref: users.id - agents.user_id
Ref: customers.id < loan_applications.customer_id

// =====================================================
// BACKEND 2 — INTERNAL RELATIONSHIPS
// These are actual foreign-key relationships.
// =====================================================

// Conversation core
Ref: conversations.id < conversation_participants.conversation_id
Ref: conversations.id < conversation_assignments.conversation_id
Ref: conversations.id < conversation_activities.conversation_id

// Messaging
Ref: conversations.id < messages.conversation_id
// Composite FK (reply_to_message_id, conversation_id) -> messages (id, conversation_id): replies stay in one conversation
Ref: messages.id < messages.reply_to_message_id
Ref: messages.id < messages.forwarded_from_message_id
Ref: messages.id < message_receipts.message_id
Ref: conversations.id < conversation_reads.conversation_id
// Composite FK (last_read_message_id, conversation_id) -> messages (id, conversation_id)
Ref: messages.id < conversation_reads.last_read_message_id
Ref: messages.id < message_edit_history.message_id
Ref: messages.id < message_reactions.message_id

// Attachments
Ref: conversations.id < attachments.conversation_id
Ref: (messages.id, messages.conversation_id) < (message_attachments.message_id, message_attachments.conversation_id)
Ref: (attachments.id, attachments.conversation_id) < (message_attachments.attachment_id, message_attachments.conversation_id)

// Notes and escalation
Ref: conversations.id < internal_notes.conversation_id
Ref: internal_notes.id < note_mentions.note_id
Ref: conversations.id < conversation_escalations.conversation_id

// Tags
Ref: conversations.id < conversation_tags.conversation_id
Ref: tags.id < conversation_tags.tag_id

// Notifications
Ref: conversations.id < notifications.conversation_id
Ref: messages.id < notifications.message_id
Ref: conversations.id < conversation_notification_settings.conversation_id

// Automation
Ref: automation_rules.id < automation_logs.rule_id
Ref: conversations.id < automation_logs.conversation_id
Ref: messages.id < automation_logs.message_id

// AI

// Calls
Ref: conversations.id < callback_requests.conversation_id
Ref: conversations.id < calls.conversation_id
Ref: calls.id < call_participants.call_id

// Moderation
Ref: conversations.id < spam_reports.conversation_id
Ref: messages.id < spam_reports.message_id

// Workspace
Ref: conversations.id < workspace_open_conversations.conversation_id
Ref: conversations.id < conversation_drafts.conversation_id

// =====================================================
// BACKEND 1 ↔ BACKEND 2 — CONCEPTUAL REFERENCES ONLY
// DO NOT create these as PostgreSQL foreign keys.
// Backend 2 stores the corresponding external IDs.
// =====================================================

Ref: customers.id < conversations.customer_id
Ref: loan_applications.id < conversations.application_id
Ref: agents.id < conversation_assignments.agent_id
Ref: agents.id < conversation_assignments.assigned_by
Ref: agents.id < internal_notes.author_agent_id
Ref: agents.id < note_mentions.mentioned_agent_id
Ref: agents.id < notification_preferences.agent_id
Ref: agents.id < conversation_notification_settings.agent_id
Ref: agents.id < agent_presence_history.agent_id
Ref: agents.id < canned_responses.created_by
Ref: agents.id < callback_requests.assigned_agent_id
Ref: customers.id < callback_requests.customer_id
Ref: agents.id < spam_reports.reviewed_by
Ref: agents.id < customer_blocks.blocked_by
Ref: customers.id < customer_blocks.customer_id
Ref: agents.id < workspace_preferences.agent_id
Ref: agents.id < workspace_open_conversations.agent_id
Ref: agents.id < conversation_drafts.agent_id
Ref: users.id < user_chat_settings.user_id
Ref: agents.id < conversations.assigned_agent_id
Ref: agents.id < conversation_assignments.ended_by
Ref: agents.id < messages.deleted_by
Ref: agents.id < callback_requests.created_by
Ref: agents.id < customer_blocks.unblocked_by
Ref: users.id < push_devices.user_id
