// GENERATED by `pnpm db:dbml` from docs/database/*.dbml (one file per domain). Edit those files, not this one.

Project Chat_Dashboard {
  database_type: 'PostgreSQL'
  Note: '''
  Chat database (Backend 2) of the loan-support chat dashboard.
  The tables are grouped by domain (01-12), one file per domain in docs/database/.
  Group 12 (Backend 1) is context only: those tables are not created here.
  '''
}

// HOW TO READ THESE FILES
// - One file per domain: its TableGroup, its tables, then the relations that start in those tables.
// - Coloured header  = the domain a table belongs to (same colour as its TableGroup).
// - Solid line       = a real foreign key in PostgreSQL.
// - Grey line        = a logical link to Backend 1 (an id is stored, no foreign key).
// - "users.id" / "Staff users.id" / "Customer users.id" in a note = the column stores a users.id but has no
//   foreign key (only conversations.customer_id, messages.sender_id and attachments.uploaded_by_id do, through
//   chat_users.external_id). Lines for these are not drawn, to keep the diagram readable.
// - Rules Prisma cannot express (CHECKs, partial unique indexes) are in backend/prisma/sql/constraints.sql.
//
// HOW TO ADD A TABLE
// 1. Put it in the file of its domain (or add a new numbered file, e.g. 12-ai.dbml, and renumber Backend 1 to stay
//    last), list it in that TableGroup and give it the group's headercolor.
// 2. Write its Refs in the same file. A person column stores users.id; note it, do not draw it.
// 3. Run `pnpm db:dbml` to rebuild docs/database-schema.dbml (the one-file copy for https://dbdiagram.io/d).
// 4. Mirror the change in the same-numbered file of backend/prisma/schema/ with a migration, and in
//    docs/database-schema.md.

// ==============================================================================================================
// 01. IDENTITY AND ACCESS
// Who people are and what they may do. users.id is the id in access tokens and the id every
// other table stores for a person (customer or staff). chat_users gives each person a chat identity and role.
// ==============================================================================================================

TableGroup "01 Identity and access" [color: #2563EB] {
  users
  refresh_tokens
  roles
  permissions
  role_permissions
  chat_users
}

Table users [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'The id in access tokens (sub); every user/agent/customer id column holds it']
  email varchar(254) [unique, note: 'Lower-case (CHECK). Null for an LOS-only account; set exactly when password_hash is (CHECK)']
  password_hash varchar(255) [note: 'scrypt$N$r$p$salt$hash. Never returned by the API']
  los_user_id int [note: 'LOS userId for accounts that sign in with an LOS token (> 0). Email or LOS: at least one (CHECK)']
  los_user_type varchar(20) [note: 'CUSTOMER or STAFF, matching the role; set exactly when los_user_id is (CHECK)']
  role varchar(20) [not null, note: 'CUSTOMER, AGENT, SUPERVISOR, ADMIN']
  display_name varchar(100) [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE or DISABLED']
  failed_login_count int [not null, default: 0, note: 'Wrong passwords in a row; >= 0']
  locked_until timestamptz [note: 'Set after 5 wrong passwords']
  password_changed_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz
  created_by uuid [note: 'Admin who created a staff account; null for self-registration']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (los_user_type, los_user_id) [unique, note: 'LOS numbers customers and staff separately']
    (role, status)
  }

  Note: 'Sign-in accounts. Email and password, an LOS link, or both (docs/api-auth.md)'
}

Table refresh_tokens [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  family_id uuid [not null, note: 'All rotations of one sign-in; a reused token revokes the family']
  token_hash char(64) [not null, unique, note: 'hex SHA-256 of the refresh token; the token itself is never stored']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  replaced_by_id uuid [unique, note: 'The session this one was rotated into (ON DELETE SET NULL); set only once revoked, never itself']
  user_agent varchar(255)
  ip_address varchar(45)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
    expires_at [note: 'The cleanup job (AUTH_SESSION_CLEANUP_INTERVAL_MINUTES) deletes expired rows']
  }
}

Table roles [headercolor: #2563EB] {
  id int [pk, increment]
  name varchar(20) [not null, unique, note: 'CUSTOMER, AGENT, SUPERVISOR or ADMIN (CHECK). Fixed: tokens and users.role carry it']
  kind varchar(20) [not null, note: 'CUSTOMER or STAFF (CHECK)']
  description varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, kind) [unique, note: 'Target of chat_users (role_id, user_type)']
  }

  Note: 'What each role may do is data (role_permissions), edited by admins (PUT /roles/:roleId/permissions)'
}

Table permissions [headercolor: #2563EB] {
  id int [pk, increment]
  module varchar(50) [not null, note: 'e.g. tags']
  action varchar(50) [not null, note: 'e.g. delete; the permission is "tags.delete"']
  description varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (module, action) [unique]
  }

  Note: 'Catalogue defined in code (shared/auth/permissions.ts) and seeded by migrations; not edited at runtime'
}

Table role_permissions [headercolor: #2563EB] {
  id int [pk, increment]
  role_id int [not null]
  permission_id int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique]
    permission_id
  }
}

Table chat_users [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_type varchar(20) [not null, note: 'CUSTOMER or STAFF: always roles.kind of role_id (composite FK)']
  external_id uuid [not null, unique, note: 'users.id (token sub; or the id in a dev: token). Never the email']
  los_user_id int [note: 'Id in the loan system (LOS): users.los_user_id, copied on LOS sign-in; null for password-only accounts']
  username varchar(100) [note: 'users.display_name, copied on sign-in and account changes']
  role_id int [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE or DISABLED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]

  indexes {
    (user_type, external_id) [unique]
    (user_type, los_user_id) [unique]
    role_id
  }
}

// Relations of identity and access
Ref: roles.(id, kind) < chat_users.(role_id, user_type) [delete: restrict]
Ref: roles.id < role_permissions.role_id [delete: cascade]
Ref: permissions.id < role_permissions.permission_id [delete: cascade]
Ref: roles.name < users.role [delete: restrict]
Ref: users.id < refresh_tokens.user_id [delete: cascade]
Ref: refresh_tokens.id - refresh_tokens.replaced_by_id [delete: set null]

// ==============================================================================================================
// 02. CONVERSATIONS
// The hub. One row per chat; who is in it, who owns it, and an audit trail of what happened.
// ==============================================================================================================

TableGroup "02 Conversations" [color: #0D9488] {
  conversations
  conversation_participants
  conversation_assignments
  conversation_activities
}

Table conversations [headercolor: #0D9488] {
  id uuid [pk, default: `gen_random_uuid()`]

  // The customer (a chat user) and the loan application (Backend 1)
  customer_id uuid [note: 'chat_users.external_id (= users.id). Required for CUSTOMER_SUPPORT, NULL for INTERNAL (CHECK)']
  application_id uuid [note: 'Backend 1 loan_applications.id']

  customer_name varchar(150) [note: 'Snapshot of the Backend 1 customer name so the inbox can be searched and sorted in SQL (FR-07); refresh when Backend 1 reports a change']
  customer_identifier varchar(100) [note: 'Snapshot of a searchable identifier (customer_code, phone, application_number)']

  conversation_type varchar(30) [not null, default: 'CUSTOMER_SUPPORT']
  channel varchar(32) [not null, default: 'web', note: 'web or mobile']
  created_by_type varchar(30) [note: 'CUSTOMER or AGENT; NULL when created by the system']
  created_by_id uuid [note: 'users.id of the customer or staff member; set exactly when created_by_type is set']
  status varchar(30) [not null, default: 'OPEN']
  priority varchar(20) [not null, default: 'MEDIUM']

  conversation_mode varchar(20) [not null, default: 'AI']
  handoff_status varchar(30) [not null, default: 'NONE']

  assigned_agent_id uuid [note: 'Staff users.id. Denormalized current OWNER from conversation_assignments for fast Mine/Unassigned filters; set exactly when handoff_status = ASSIGNED (CHECK)']

  subject varchar(255)
  summary text

  is_archived boolean [not null, default: false]
  archived_at timestamptz
  resolved_at timestamptz
  closed_at timestamptz
  last_message_at timestamptz [not null, default: `now()`]
  last_message_preview varchar(255) [note: 'Denormalized; updated in the same transaction as the message insert']
  last_sequence_number bigint [not null, default: 0, note: 'Last messages.sequence_number issued. Allocate with UPDATE ... SET last_sequence_number = last_sequence_number + 1 RETURNING']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, last_message_at)
    customer_id
    application_id
    (priority, last_message_at)
    (assigned_agent_id, last_message_at)
    (is_archived, last_message_at)
    conversation_type
  }

  Note: 'CUSTOMER_SUPPORT or INTERNAL. The hub table: most other tables reference conversations.id.'
}

Table conversation_participants [headercolor: #0D9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  participant_type varchar(30) [not null, note: 'CUSTOMER, AGENT, ASSISTANT']
  participant_id uuid [note: 'users.id of the customer or staff member; NULL exactly when ASSISTANT (CHECK)']
  participant_role varchar(30) [not null, default: 'MEMBER', note: 'OWNER, VIEWER, MEMBER']

  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz

  indexes {
    conversation_id
    (participant_type, participant_id)
  }
}

Table conversation_assignments [headercolor: #0D9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  agent_id uuid [not null, note: 'Staff users.id']
  assigned_by uuid [note: 'Staff users.id']

  assignment_type varchar(30) [not null, default: 'OWNER', note: 'OWNER or VIEWER']
  assignment_action varchar(30) [not null, default: 'ASSIGNED', note: 'TAKEOVER, ASSIGNED, TRANSFERRED, AUTO_ASSIGNED']
  note varchar(500)

  assigned_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  ended_by uuid [note: 'Staff users.id; NULL when ended by the system']

  indexes {
    (conversation_id, ended_at)
    (agent_id, ended_at)
  }
}

Table conversation_activities [headercolor: #0D9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  actor_type varchar(30) [not null]
  actor_id uuid [note: 'users.id; null for the system']

  activity_type varchar(50) [not null]
  description text
  metadata jsonb

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
    (conversation_id, activity_type)
  }
}

// Relations of conversations
Ref: chat_users.external_id < conversations.customer_id [delete: restrict]
Ref: conversations.id < conversation_participants.conversation_id [delete: cascade]
Ref: conversations.id < conversation_assignments.conversation_id [delete: restrict]
Ref: conversations.id < conversation_activities.conversation_id [delete: restrict]
Ref: loan_applications.id < conversations.application_id [color: #9CA3AF]

// ==============================================================================================================
// 03. MESSAGES
// Messages in a conversation (ordered by sequence_number) and per-person state: receipts, reads, edits, reactions.
// ==============================================================================================================

TableGroup "03 Messages" [color: #7C3AED] {
  messages
  message_receipts
  conversation_reads
  message_edit_history
  message_reactions
}

Table messages [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  client_id varchar(100) [note: 'Client-generated ID for duplicate prevention']
  sequence_number bigint [not null]

  sender_type varchar(30) [not null, note: 'CUSTOMER, AGENT, ASSISTANT, SYSTEM']
  sender_id uuid [note: 'chat_users.external_id (= users.id) for CUSTOMER and AGENT; null for SYSTEM and ASSISTANT']

  message_type varchar(30) [not null, default: 'TEXT']
  content text
  metadata jsonb [note: 'Payload for SYSTEM messages, e.g. who took over; call or callback references']

  reply_to_message_id uuid
  forwarded_from_message_id uuid

  status varchar(20) [not null, default: 'SENT', note: 'Sender-facing summary: SENDING, SENT, DELIVERED, READ, FAILED. Per-recipient detail is in message_receipts']

  is_edited boolean [not null, default: false]
  edited_at timestamptz
  deleted_at timestamptz
  deleted_by uuid [note: 'Staff users.id']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, sequence_number) [unique]
    (conversation_id, client_id) [unique]
    (id, conversation_id) [unique]
    (conversation_id, created_at)
    (sender_type, sender_id)
    reply_to_message_id
    forwarded_from_message_id
  }
}

Table message_receipts [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  recipient_type varchar(30) [not null]
  recipient_id uuid [not null]

  delivered_at timestamptz
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, recipient_type, recipient_id) [unique]
    (recipient_type, recipient_id, read_at)
  }
}

Table conversation_reads [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  reader_type varchar(30) [not null]
  reader_id uuid [not null]

  last_read_message_id uuid
  last_read_sequence_number bigint [not null, default: 0, note: 'Unread count = conversations.last_sequence_number - this (approximate: includes own and system messages)']
  last_read_at timestamptz
  marked_unread boolean [not null, default: false, note: 'Agent manually marked the conversation unread (FR-05)']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, reader_type, reader_id) [unique]
    last_read_message_id
  }
}

Table message_edit_history [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  editor_type varchar(30) [not null]
  editor_id uuid [not null]

  previous_content text [not null]
  edited_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, edited_at)
  }
}

Table message_reactions [headercolor: #7C3AED] {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]

  user_type varchar(30) [not null]
  user_id uuid [not null]

  emoji varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, user_type, user_id, emoji) [unique]
  }
}

// Relations of messages
Ref: conversations.id < messages.conversation_id [delete: restrict]
Ref: chat_users.external_id < messages.sender_id [delete: restrict]
Ref: messages.(id, conversation_id) < messages.(reply_to_message_id, conversation_id) [delete: restrict]
Ref: messages.id < messages.forwarded_from_message_id [delete: set null]
Ref: messages.id < message_receipts.message_id [delete: cascade]
Ref: conversations.id < conversation_reads.conversation_id [delete: cascade]
Ref: messages.(id, conversation_id) < conversation_reads.(last_read_message_id, conversation_id) [delete: restrict]
Ref: messages.id < message_edit_history.message_id [delete: cascade]
Ref: messages.id < message_reactions.message_id [delete: cascade]

// ==============================================================================================================
// 04. ATTACHMENTS
// Uploaded files. A file is uploaded first, then linked to one or more messages of the same conversation.
// ==============================================================================================================

TableGroup "04 Attachments" [color: #9333EA] {
  attachments
  message_attachments
}

Table attachments [headercolor: #9333EA] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, note: 'Needed for the Media & Files panel and access control; an upload exists before its message']

  uploaded_by_type varchar(30) [not null]
  uploaded_by_id uuid [not null, note: 'chat_users.external_id (= users.id)']

  storage_key varchar(500) [not null, unique]
  file_name varchar(255) [not null]
  mime_type varchar(150) [not null]
  file_size bigint [not null]
  duration_ms int [note: 'Audio, video and voice messages (FR-18)']
  waveform jsonb [note: 'Voice message amplitude samples']
  checksum_sha256 varchar(64)

  upload_status varchar(30) [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (conversation_id, created_at)
    (uploaded_by_type, uploaded_by_id)
    (upload_status, created_at)
    (id, conversation_id) [unique]
  }
}

Table message_attachments [headercolor: #9333EA] {
  message_id uuid [not null]
  attachment_id uuid [not null]
  conversation_id uuid [not null, note: 'Must match both the message and attachment conversation (composite foreign keys)']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, attachment_id) [pk]
    conversation_id
    attachment_id
  }
}

// Relations of attachments
Ref: conversations.id < attachments.conversation_id [delete: restrict]
Ref: chat_users.external_id < attachments.uploaded_by_id [delete: restrict]
Ref: messages.(id, conversation_id) < message_attachments.(message_id, conversation_id) [delete: cascade]
Ref: attachments.(id, conversation_id) < message_attachments.(attachment_id, conversation_id) [delete: cascade]

// ==============================================================================================================
// 05. NOTES AND ESCALATIONS
// Staff-only: internal notes with @mentions, and escalations to a supervisor.
// ==============================================================================================================

TableGroup "05 Notes and escalations" [color: #D97706] {
  internal_notes
  note_mentions
  conversation_escalations
}

Table internal_notes [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  author_agent_id uuid [not null, note: 'Staff users.id']
  content text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (conversation_id, created_at)
  }
}

Table note_mentions [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  note_id uuid [not null]
  mentioned_agent_id uuid [not null, note: 'Staff users.id']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (note_id, mentioned_agent_id) [unique]
    mentioned_agent_id
  }
}

Table conversation_escalations [headercolor: #D97706] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  requested_by uuid [not null, note: 'Staff users.id']
  reason text

  status varchar(30) [not null, default: 'PENDING']
  resolved_by uuid [note: 'Staff users.id']

  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    (conversation_id, status)
  }
}

// Relations of notes and escalations
Ref: conversations.id < internal_notes.conversation_id [delete: restrict]
Ref: internal_notes.id < note_mentions.note_id [delete: cascade]
Ref: conversations.id < conversation_escalations.conversation_id [delete: restrict]

// ==============================================================================================================
// 06. TAGS
// Labels for conversations (many-to-many).
// ==============================================================================================================

TableGroup "06 Tags" [color: #CA8A04] {
  tags
  conversation_tags
}

Table tags [headercolor: #CA8A04] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  color varchar(30)

  created_by uuid [note: 'Staff users.id']
  created_at timestamptz [not null, default: `now()`]
}

Table conversation_tags [headercolor: #CA8A04] {
  conversation_id uuid [not null]
  tag_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, tag_id) [pk]
    tag_id
  }
}

// Relations of tags
Ref: conversations.id < conversation_tags.conversation_id [delete: cascade]
Ref: tags.id < conversation_tags.tag_id [delete: cascade]

// ==============================================================================================================
// 07. NOTIFICATIONS AND PRESENCE
// In-app notifications, per-agent and per-conversation switches, push devices and presence history.
// ==============================================================================================================

TableGroup "07 Notifications and presence" [color: #DC2626] {
  notifications
  notification_preferences
  conversation_notification_settings
  push_devices
  agent_presence_history
}

Table notifications [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]

  recipient_type varchar(30) [not null]
  recipient_id uuid [not null, note: 'users.id']

  conversation_id uuid
  message_id uuid

  notification_type varchar(50) [not null]
  title varchar(255) [not null]
  body text

  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_type, recipient_id, created_at)
    (recipient_type, recipient_id, read_at)
    conversation_id
    message_id
  }
}

Table notification_preferences [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, unique, note: 'Staff users.id']

  new_message_enabled boolean [not null, default: true]
  assignment_enabled boolean [not null, default: true]
  transfer_enabled boolean [not null, default: true]
  mention_enabled boolean [not null, default: true]

  sound_enabled boolean [not null, default: true]
  browser_enabled boolean [not null, default: true]

  updated_at timestamptz [not null, default: `now()`]
}

Table conversation_notification_settings [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]
  agent_id uuid [not null, note: 'Staff users.id']

  is_muted boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, agent_id) [unique]
    agent_id
  }
}

Table push_devices [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'users.id of a customer or staff member']

  platform varchar(30) [not null]
  device_token varchar(512) [not null]
  is_active boolean [not null, default: true]

  last_seen_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (platform, device_token) [unique]
    user_id
  }
}

Table agent_presence_history [headercolor: #DC2626] {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'Staff users.id']

  status varchar(30) [not null, note: 'AVAILABLE, BUSY, AWAY, OFFLINE']

  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  indexes {
    (agent_id, ended_at)
  }

  Note: 'History only. Live presence (Available/Busy/Away/Offline) is kept in Redis.'
}

// Relations of notifications and presence
Ref: conversations.id < notifications.conversation_id [delete: set null]
Ref: messages.id < notifications.message_id [delete: set null]
Ref: conversations.id < conversation_notification_settings.conversation_id [delete: cascade]

// ==============================================================================================================
// 08. AGENT WORKSPACE
// Per-person UI state: layout, open tabs, unsent drafts and chat settings.
// ==============================================================================================================

TableGroup "08 Agent workspace" [color: #4B5563] {
  workspace_preferences
  workspace_open_conversations
  conversation_drafts
  user_chat_settings
}

Table workspace_preferences [headercolor: #4B5563] {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, unique, note: 'Staff users.id']

  layout jsonb
  sidebar_width int
  settings jsonb

  updated_at timestamptz [not null, default: `now()`]
}

Table workspace_open_conversations [headercolor: #4B5563] {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'Staff users.id']
  conversation_id uuid [not null]

  sort_order int [not null, default: 0]
  last_opened_at timestamptz [not null, default: `now()`]

  indexes {
    (agent_id, conversation_id) [unique]
    conversation_id
  }
}

Table conversation_drafts [headercolor: #4B5563] {
  id uuid [pk, default: `gen_random_uuid()`]
  agent_id uuid [not null, note: 'Staff users.id']
  conversation_id uuid [not null]

  content text [not null, note: 'Unsent composer text, at most 10000 characters. An empty draft is deleted, not stored.']

  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (agent_id, conversation_id) [unique]
    conversation_id
  }
}

Table user_chat_settings [headercolor: #4B5563] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, note: 'users.id']

  typing_sound_enabled boolean [not null, default: true]
  notification_sound_enabled boolean [not null, default: true]
  ai_suggestions_enabled boolean [not null, default: true]
  ai_summaries_enabled boolean [not null, default: true]
  auto_assign_enabled boolean [not null, default: false, note: 'Opt in to auto-assignment (only when authorized)']

  updated_at timestamptz [not null, default: `now()`]
}

// Relations of agent workspace
Ref: conversations.id < workspace_open_conversations.conversation_id [delete: cascade]
Ref: conversations.id < conversation_drafts.conversation_id [delete: cascade]

// ==============================================================================================================
// 09. REPLIES AND AUTOMATION
// Saved reply templates and rule-based automatic replies with their execution log.
// ==============================================================================================================

TableGroup "09 Replies and automation" [color: #059669] {
  canned_responses
  automation_rules
  automation_logs
}

Table canned_responses [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  content text [not null]

  shortcut varchar(50) [note: 'e.g. /greeting']

  scope varchar(30) [not null, default: 'PERSONAL', note: 'PERSONAL, SHARED (everyone) or TEAM (unused until Backend 1 defines teams)']
  team_id uuid [note: 'Backend 1 team id; set exactly when scope = TEAM (CHECK)']
  created_by uuid [not null, note: 'Staff users.id']

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (created_by, is_active)
    (team_id, is_active)
  }
}

Table automation_rules [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]

  trigger_type varchar(50) [not null]
  conditions jsonb
  response_content text [not null]

  priority int [not null, default: 0]
  is_active boolean [not null, default: true]

  created_by uuid [note: 'Staff users.id']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, trigger_type, priority)
  }
}

Table automation_logs [headercolor: #059669] {
  id uuid [pk, default: `gen_random_uuid()`]
  rule_id uuid [not null]
  conversation_id uuid [not null]
  message_id uuid

  execution_status varchar(30) [not null]
  error_message text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (rule_id, created_at)
    conversation_id
    message_id
  }
}

// Relations of replies and automation
Ref: automation_rules.id < automation_logs.rule_id [delete: restrict]
Ref: conversations.id < automation_logs.conversation_id [delete: restrict]
Ref: messages.id < automation_logs.message_id [delete: set null]

// ==============================================================================================================
// 10. CALLBACKS AND CALLS
// Scheduled callbacks and in-app call signalling history (media is not stored).
// ==============================================================================================================

TableGroup "10 Callbacks and calls" [color: #0284C7] {
  callback_requests
  calls
  call_participants
}

Table callback_requests [headercolor: #0284C7] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  customer_id uuid [not null, note: 'Customer users.id']
  assigned_agent_id uuid [note: 'Staff users.id']

  created_by uuid [note: 'Staff users.id']

  scheduled_at timestamptz [not null]
  status varchar(30) [not null, default: 'PENDING']

  notes text
  completion_note text
  reminder_sent_at timestamptz [note: 'Set when the upcoming-callback notification was sent']

  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (assigned_agent_id, status, scheduled_at)
    (status, scheduled_at)
    conversation_id
    customer_id
  }
}

Table calls [headercolor: #0284C7] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  initiated_by_type varchar(30) [not null]
  initiated_by_id uuid [not null]

  call_type varchar(20) [not null]
  status varchar(30) [not null, default: 'INITIATING']

  started_at timestamptz
  ended_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
  }

  Note: 'Signalling record and call history; media is not stored.'
}

Table call_participants [headercolor: #0284C7] {
  id uuid [pk, default: `gen_random_uuid()`]
  call_id uuid [not null]

  participant_type varchar(30) [not null]
  participant_id uuid [not null]

  joined_at timestamptz
  left_at timestamptz

  indexes {
    (call_id, participant_type, participant_id) [unique]
    (participant_type, participant_id)
  }
}

// Relations of callbacks and calls
Ref: conversations.id < callback_requests.conversation_id [delete: restrict]
Ref: conversations.id < calls.conversation_id [delete: restrict]
Ref: calls.id < call_participants.call_id [delete: cascade]

// ==============================================================================================================
// 11. MODERATION
// Spam reports, customer blocks, blocked keywords and the moderation audit log.
// ==============================================================================================================

TableGroup "11 Moderation" [color: #BE123C] {
  spam_reports
  customer_blocks
  blocked_keywords
  moderation_activities
}

Table spam_reports [headercolor: #BE123C] {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]

  reported_by_type varchar(30) [not null]
  reported_by_id uuid [not null]

  message_id uuid [note: 'The reported message, if any']

  reason text [not null]
  status varchar(30) [not null, default: 'PENDING']

  reviewed_by uuid [note: 'Staff users.id']
  reviewed_at timestamptz
  resolution_note varchar(500)

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, created_at)
    conversation_id
    message_id
  }
}

Table customer_blocks [headercolor: #BE123C] {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null, note: 'Customer users.id']
  blocked_by uuid [not null, note: 'Staff users.id']

  reason text

  blocked_at timestamptz [not null, default: `now()`]
  unblocked_at timestamptz
  unblocked_by uuid [note: 'Staff users.id']

  indexes {
    (customer_id, unblocked_at)
  }

  Note: 'One active block (unblocked_at IS NULL) per customer via a partial unique index.'
}

Table blocked_keywords [headercolor: #BE123C] {
  id uuid [pk, default: `gen_random_uuid()`]
  keyword varchar(255) [not null, unique]

  is_active boolean [not null, default: true]
  created_by uuid [note: 'Staff users.id']

  created_at timestamptz [not null, default: `now()`]
}

Table moderation_activities [headercolor: #BE123C] {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [not null, note: 'Staff users.id']

  action varchar(100) [not null]
  target_type varchar(50) [not null]
  target_id uuid [not null]

  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, created_at)
    (target_type, target_id)
  }
}

// Relations of moderation
Ref: conversations.id < spam_reports.conversation_id [delete: restrict]
Ref: messages.id < spam_reports.message_id [delete: set null]

// ==============================================================================================================
// 12. BACKEND 1 — EXTERNAL, NOT CREATED HERE
// Loan-system data owned by Backend 1 (its API is not known yet). Shown for context only:
// these tables do not exist in the chat database and nothing has a foreign key to them.
// ==============================================================================================================

TableGroup "12 Backend 1 (external)" [color: #94A3B8] {
  customers
  agents
  loan_applications
}

Table customers [headercolor: #94A3B8] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  customer_code varchar(100)
  phone varchar(30)
  address text
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — customer profiles owned by Backend 1'
}

Table agents [headercolor: #94A3B8] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  employee_code varchar(100)
  department varchar(100)
  is_available boolean
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — agent profiles owned by Backend 1'
}

Table loan_applications [headercolor: #94A3B8] {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  application_number varchar(100)
  loan_type varchar(100)
  amount decimal(15,2)
  status varchar(50)
  submitted_at timestamptz
  created_at timestamptz
  updated_at timestamptz

  Note: 'EXTERNAL TABLE — loan application data owned by Backend 1'
}

// Relations of backend 1
Ref: users.id - customers.user_id [color: #9CA3AF]
Ref: users.id - agents.user_id [color: #9CA3AF]
Ref: customers.id < loan_applications.customer_id [color: #9CA3AF]
