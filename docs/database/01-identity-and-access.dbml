// ==============================================================================================================
// 01. IDENTITY AND ACCESS
// Who people are and what they may do. users.id is the id in access tokens and the id every
// other table stores for a person (customer or staff). chat_users gives each person a chat identity and role.
// ==============================================================================================================

TableGroup "01 Identity and access" [color: #2563EB] {
  users
  staff
  customers
  refresh_tokens
  roles
  permissions
  role_permissions
  chat_users
}

Table users [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'The id in access tokens (sub); every user/agent/customer id column holds it']
  email varchar(254) [unique, note: 'Lower-case (CHECK). Null for an LOS-only account; set exactly when password_hash is (CHECK)']
  password_hash varchar(255) [note: 'scrypt$N$r$p$salt$hash. Never returned by the API']
  los_user_id int [note: 'LOS userId for accounts that sign in with an LOS token (> 0). Email or LOS: at least one (CHECK)']
  los_user_type varchar(20) [note: 'CUSTOMER or STAFF, matching the role; set exactly when los_user_id is (CHECK)']
  role varchar(20) [not null, note: 'CUSTOMER, AGENT, SUPERVISOR, ADMIN']
  display_name varchar(100) [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE or DISABLED']
  failed_login_count int [not null, default: 0, note: 'Wrong passwords in a row; >= 0']
  locked_until timestamptz [note: 'Set after 5 wrong passwords']
  password_changed_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz
  created_by uuid [note: 'Admin who created a staff account; null for self-registration']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (los_user_type, los_user_id) [unique, note: 'LOS numbers customers and staff separately']
    (role, status)
  }

  Note: 'Sign-in accounts. Email and password, an LOS link, or both (docs/api-auth.md)'
}

Table staff [headercolor: #2563EB] {
  user_id uuid [pk, note: 'users.id of a staff account (AGENT, SUPERVISOR, ADMIN); created with the account']
  employee_code varchar(100) [unique, note: "The organisation's staff number"]
  department varchar(100)
  max_concurrent_chats int [note: 'Most open chats to own at once (> 0, CHECK); null = no limit. Not yet enforced']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Staff side of an account, 1:1 with users. That the account is staff is checked by the application'
}

Table customers [headercolor: #2563EB] {
  user_id uuid [pk, note: 'users.id of a CUSTOMER account; created with the account']
  phone varchar(30) [note: 'E.164, e.g. +85512345678 (CHECK)']
  customer_code varchar(100) [unique, note: "The customer's code in the loan system (LOS)"]
  preferred_language varchar(10) [note: 'BCP 47 tag, e.g. km or en']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Customer side of an account, 1:1 with users. Loan data stays in Backend 1'
}

Table refresh_tokens [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  family_id uuid [not null, note: 'All rotations of one sign-in; a reused token revokes the family']
  token_hash char(64) [not null, unique, note: 'hex SHA-256 of the refresh token; the token itself is never stored']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  replaced_by_id uuid [unique, note: 'The session this one was rotated into (ON DELETE SET NULL); set only once revoked, never itself']
  user_agent varchar(255)
  ip_address varchar(45)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
    expires_at [note: 'The cleanup job (AUTH_SESSION_CLEANUP_INTERVAL_MINUTES) deletes expired rows']
  }
}

Table external_identities [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  provider varchar(20) [not null, note: 'LOS (CHECK). The outside sign-in provider']
  external_user_id varchar(100) [not null, note: 'The provider id of the person (LOS userId, decimal text)']
  external_user_type varchar(20) [not null, note: 'CUSTOMER or STAFF (CHECK); LOS numbers each kind separately']
  chat_user_id uuid [not null, note: 'users.id (ON DELETE CASCADE)']
  linked_by uuid [note: 'The admin who linked it; null when created by the provider first sign-in']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, external_user_type, external_user_id) [unique, note: 'One chat account per outside identity']
    (chat_user_id, provider) [unique, note: 'One identity per provider per account']
  }

  Note: 'Explicit mapping from an LOS identity to the one chat account it signs into. Never matched by email or phone. users.los_user_type/los_user_id stay as a copy written in the same transaction'
}

Table auth_audit_events [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  event varchar(40) [not null, note: 'LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, LOGOUT_ALL, REFRESH_REUSE_DETECTED, SESSIONS_REVOKED, IDENTITY_LINKED, IDENTITY_UNLINKED']
  provider varchar(20) [not null, note: 'CHAT or LOS']
  outcome varchar(10) [not null, note: 'SUCCESS or FAILURE (CHECK)']
  user_id uuid [note: 'The account concerned, when known (ON DELETE SET NULL)']
  actor_id uuid [note: 'The admin who did it, for admin actions']
  attempted_username varchar(32) [note: 'Only when the typed text has the shape of a username']
  reason varchar(60) [note: 'BAD_PASSWORD, UNKNOWN_USER, DISABLED, LOCKED, WRONG_AUDIENCE, LOS_UNAVAILABLE, LOS_REFUSED, ...']
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    created_at
  }

  Note: 'Append-only. Never holds passwords, tokens or token hashes'
}

Table roles [headercolor: #2563EB] {
  id int [pk, increment]
  name varchar(20) [not null, unique, note: 'CUSTOMER, AGENT, SUPERVISOR or ADMIN (CHECK). Fixed: tokens and users.role carry it']
  kind varchar(20) [not null, note: 'CUSTOMER or STAFF (CHECK)']
  description varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, kind) [unique, note: 'Target of chat_users (role_id, user_type)']
  }

  Note: 'What each role may do is data (role_permissions), edited by admins (PUT /roles/:roleId/permissions)'
}

Table permissions [headercolor: #2563EB] {
  id int [pk, increment]
  module varchar(50) [not null, note: 'e.g. tags']
  action varchar(50) [not null, note: 'e.g. delete; the permission is "tags.delete"']
  description varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (module, action) [unique]
  }

  Note: 'Catalogue defined in code (shared/auth/permissions.ts) and seeded by migrations; not edited at runtime'
}

Table role_permissions [headercolor: #2563EB] {
  id int [pk, increment]
  role_id int [not null]
  permission_id int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique]
    permission_id
  }
}

Table chat_users [headercolor: #2563EB] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_type varchar(20) [not null, note: 'CUSTOMER or STAFF: always roles.kind of role_id (composite FK)']
  external_id uuid [not null, unique, note: 'users.id (token sub; or the id in a dev: token). Never the email']
  los_user_id int [note: 'Id in the loan system (LOS): users.los_user_id, copied on LOS sign-in; null for password-only accounts']
  username varchar(100) [note: 'users.display_name, copied on sign-in and account changes']
  role_id int [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE or DISABLED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]

  indexes {
    (user_type, external_id) [unique]
    (user_type, los_user_id) [unique]
    role_id
  }
}

// Relations of identity and access
Ref: roles.(id, kind) < chat_users.(role_id, user_type) [delete: restrict]
Ref: roles.id < role_permissions.role_id [delete: cascade]
Ref: permissions.id < role_permissions.permission_id [delete: cascade]
Ref: roles.name < users.role [delete: restrict]
Ref: users.id < refresh_tokens.user_id [delete: cascade]
Ref: users.id - staff.user_id [delete: cascade]
Ref: users.id - customers.user_id [delete: cascade]
Ref: refresh_tokens.id - refresh_tokens.replaced_by_id [delete: set null]
Ref: users.id < external_identities.chat_user_id [delete: cascade]
Ref: users.id < auth_audit_events.user_id [delete: set null]
