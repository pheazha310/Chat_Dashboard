NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat?schema=public"
REDIS_URL="redis://localhost:6379"
# Authentication (docs/api-auth.md). "jwt" = only tokens issued by /auth/login; "dev" also accepts dev:<uuid>:<ROLE>.
AUTH_MODE=dev
# JWT_SECRET=   (at least 32 random characters, e.g. `openssl rand -base64 48`; required in production, never commit it)
STAFF_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=3600
# How long one sign-in lasts; refreshing does not extend it.
REFRESH_TOKEN_TTL_DAYS=30
# Background deletion of expired sessions (minutes; 0 = off).
AUTH_SESSION_CLEANUP_INTERVAL_MINUTES=60
# Sign in with LOS (POST /auth/los). Off while LOS_ISSUER is empty; then set LOS_JWKS_URL or LOS_PUBLIC_KEY (PEM).
# LOS_ISSUER=
# LOS_JWKS_URL=
# LOS_PUBLIC_KEY=
LOS_CUSTOMER_AUDIENCE=luyleun
LOS_HANDOFF_AUDIENCE=chat
LOS_HANDOFF_TOKEN_TYPE=chat-handoff
# aud of the LOS staff access token received when staff sign in with their LOS username and password (empty = off)
LOS_STAFF_ACCESS_AUDIENCE=los-client
# LOS staff role names that differ from AGENT/SUPERVISOR/ADMIN, e.g. loan_officer:AGENT,branch_manager:SUPERVISOR
# Proposed for LOS (pending business approval): CREDIT_SUPPORT_OFFICER:AGENT,COLLECTION_OFFICER:AGENT,CREDIT_SUPPORT_SUPERVISOR:SUPERVISOR,COLLECTION_SUPERVISOR:SUPERVISOR,OPERATION_SUPERVISOR:SUPERVISOR,ADMIN:ADMIN,SUPER_ADMIN:ADMIN
LOS_STAFF_ROLE_MAP=
# The LOS API; its host must match LOS_JWKS_URL (Dev and Staging have different signing keys).
# Dev: https://api-dev.los.delightech.asia/api/v1   Staging: https://api-uat.los.delightech.asia/api/v1
# LOS_BASE_URL=
# Longest life (seconds) accepted for a staff hand-off token.
LOS_HANDOFF_TOKEN_MAX_AGE=120
# How long a staff session from an LOS hand-off lasts (seconds); then a fresh hand-off is needed.
LOS_STAFF_SESSION_SECONDS=3600
# Exact origins (no path, no wildcard) of LOS Web (Staging: https://cms-uat.delightech.asia) and of this dashboard.
# LOS_WEB_ORIGIN=
# CHAT_WEB_ORIGIN=
# PENDING at LOS (machine-to-machine access is not built yet); not read by anything today. Never commit real values.
# LOS_SERVICE_API_KEY=
LOS_SERVICE_ALLOWED_IPS=
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=0
# Optional, tests only: a throwaway PostgreSQL database (name must contain "test") with the migration applied.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat_test"
EVENT_BUS=redis
# Optional, tests only: a throwaway Redis (it is flushed) for the WebSocket/presence integration tests.
# TEST_REDIS_URL="redis://127.0.0.1:6390"
# Agent/customer names: "local" reads the users table (use this in production), "dev" returns synthetic profiles.
BACKEND1_MODE=dev
# Uploaded files (FR-17/18). The database holds only their metadata. "local" = files under STORAGE_DIR (one server);
# "s3" = an S3 bucket, or an S3-compatible store through S3_ENDPOINT (several servers). See docs/api-attachments.md.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# With STORAGE_DRIVER=s3 (bucket and region required). Credentials: S3_ACCESS_KEY + S3_SECRET_KEY in your real .env
# (never commit them), or leave both unset to use the standard AWS chain (AWS_ACCESS_KEY_ID, a profile, an IAM role).
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=   (only for MinIO, R2, ...; e.g. http://localhost:9000)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
# Optional, tests only: a throwaway S3-compatible bucket for s3-storage.integration.test.ts.
# TEST_S3_ENDPOINT=http://localhost:9090
# TEST_S3_BUCKET=chat-test
MAX_UPLOAD_BYTES=26214400
# Callbacks (FR-25). The reminder/missed job runs in the API process; 0 disables it.
CALLBACK_JOB_INTERVAL_SECONDS=30
CALLBACK_REMINDER_MINUTES=10
CALLBACK_MISSED_AFTER_MINUTES=15
# Calls (FR-26). Only signalling goes through this server. STUN/TURN are empty by default (set your own servers).
CALL_RING_TIMEOUT_SECONDS=45
CALL_MAX_MINUTES=240
CALL_JOB_INTERVAL_SECONDS=10
CALL_STUN_URLS=
CALL_TURN_URLS=
# CALL_TURN_SECRET=   (coturn use-auth-secret; set in your real .env, never commit it)
CALL_TURN_TTL_SECONDS=3600
# CALL_TURN_USERNAME=   (only for a TURN server without a shared secret)
# CALL_TURN_CREDENTIAL=   (set in your real .env, never commit it)
