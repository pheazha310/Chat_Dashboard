generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// GENERATED from docs/database-schema.dbml. Edit the DBML, then regenerate.
//
// This service (Backend 2, the chat backend) owns chat data. Backend 1 tables are documentation
// references only and are not created in this database. Columns that hold a Backend 1 id
// (customer_id, application_id, agent_id, user_id, *_by,
// actor/participant/sender ids) are plain UUID columns with NO foreign key.
//
// No database enums: fixed-value columns are VARCHAR strings whose allowed values are enforced by
// CHECK constraints in prisma/sql/constraints.sql and listed in docs/database-schema.md.
// Ids are UUIDs (gen_random_uuid()), including references to Backend 1 ids; they serialize to JSON as-is.

/// CUSTOMER_SUPPORT or INTERNAL. Customer and application are external references.
model Conversation {
  id                               String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId                       String?                           @map("customer_id") @db.Uuid /// External customers.id. Required for CUSTOMER_SUPPORT, NULL for INTERNAL (CHECK)
  applicationId                    String?                           @map("application_id") @db.Uuid /// External loan_applications.id
  customerName                     String?                           @map("customer_name") @db.VarChar(150) /// Snapshot of the Backend 1 customer name so the inbox can be searched and sorted in SQL (FR-07); refresh when Backend 1 reports a change
  customerIdentifier               String?                           @map("customer_identifier") @db.VarChar(100) /// Snapshot of a searchable identifier (customer_code, phone, application_number)
  conversationType                 String                            @default("CUSTOMER_SUPPORT") @map("conversation_type") @db.VarChar(30)
  channel                          String                            @default("web") @db.VarChar(32) /// web or mobile
  createdByType                    String?                           @map("created_by_type") @db.VarChar(30) /// CUSTOMER or AGENT; NULL when created by the system
  createdById                      String?                           @map("created_by_id") @db.Uuid /// External customers.id or agents.id; set exactly when created_by_type is set
  status                           String                            @default("OPEN") @db.VarChar(30)
  priority                         String                            @default("MEDIUM") @db.VarChar(20)
  conversationMode                 String                            @default("AI") @map("conversation_mode") @db.VarChar(20)
  handoffStatus                    String                            @default("NONE") @map("handoff_status") @db.VarChar(30)
  assignedAgentId                  String?                           @map("assigned_agent_id") @db.Uuid /// External agents.id. Denormalized current OWNER from conversation_assignments for fast Mine/Unassigned filters; set exactly when handoff_status = ASSIGNED (CHECK)
  subject                          String?                           @db.VarChar(255)
  summary                          String?                           @db.Text
  isArchived                       Boolean                           @default(false) @map("is_archived")
  archivedAt                       DateTime?                         @map("archived_at") @db.Timestamptz(6)
  resolvedAt                       DateTime?                         @map("resolved_at") @db.Timestamptz(6)
  closedAt                         DateTime?                         @map("closed_at") @db.Timestamptz(6)
  lastMessageAt                    DateTime                          @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview               String?                           @map("last_message_preview") @db.VarChar(255) /// Denormalized; updated in the same transaction as the message insert
  lastSequenceNumber               BigInt                            @default(0) @map("last_sequence_number") /// Last messages.sequence_number issued. Allocate with UPDATE ... SET last_sequence_number = last_sequence_number + 1 RETURNING
  createdAt                        DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversationParticipants         ConversationParticipant[]
  conversationAssignments          ConversationAssignment[]
  conversationActivities           ConversationActivity[]
  messages                         Message[]
  conversationReads                ConversationRead[]
  attachments                      Attachment[]
  internalNotes                    InternalNote[]
  conversationEscalations          ConversationEscalation[]
  conversationTags                 ConversationTag[]
  notifications                    Notification[]
  conversationNotificationSettings ConversationNotificationSetting[]
  automationLogs                   AutomationLog[]
  callbackRequests                 CallbackRequest[]
  calls                            Call[]
  spamReports                      SpamReport[]
  workspaceOpenConversations       WorkspaceOpenConversation[]

  @@index([status, lastMessageAt])
  @@index([customerId])
  @@index([applicationId])
  @@index([priority, lastMessageAt])
  @@index([assignedAgentId, lastMessageAt])
  @@index([isArchived, lastMessageAt])
  @@index([conversationType])
  @@map("conversations")
}

model ConversationParticipant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  participantType String       @map("participant_type") @db.VarChar(30) /// CUSTOMER, AGENT, ASSISTANT
  participantId   String?      @map("participant_id") @db.Uuid /// External customers.id or agents.id; NULL exactly when ASSISTANT (CHECK)
  participantRole String       @default("MEMBER") @map("participant_role") @db.VarChar(30) /// OWNER, VIEWER, MEMBER
  joinedAt        DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?    @map("left_at") @db.Timestamptz(6)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([participantType, participantId])
  @@map("conversation_participants")
}

model ConversationAssignment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  agentId          String       @map("agent_id") @db.Uuid /// External agents.id
  assignedBy       String?      @map("assigned_by") @db.Uuid /// External agents.id
  assignmentType   String       @default("OWNER") @map("assignment_type") @db.VarChar(30) /// OWNER or VIEWER
  assignmentAction String       @default("ASSIGNED") @map("assignment_action") @db.VarChar(30) /// TAKEOVER, ASSIGNED, TRANSFERRED, AUTO_ASSIGNED
  note             String?      @db.VarChar(500)
  assignedAt       DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt          DateTime?    @map("ended_at") @db.Timestamptz(6)
  endedBy          String?      @map("ended_by") @db.Uuid /// External agents.id; NULL when ended by the system
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, endedAt])
  @@index([agentId, endedAt])
  @@map("conversation_assignments")
}

model ConversationActivity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  actorType      String       @map("actor_type") @db.VarChar(30)
  actorId        String?      @map("actor_id") @db.Uuid /// External actor ID; null for system
  activityType   String       @map("activity_type") @db.VarChar(50)
  description    String?      @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([conversationId, activityType])
  @@map("conversation_activities")
}

model Message {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId         String               @map("conversation_id") @db.Uuid
  clientId               String?              @map("client_id") @db.VarChar(100) /// Client-generated ID for duplicate prevention
  sequenceNumber         BigInt               @map("sequence_number")
  senderType             String               @map("sender_type") @db.VarChar(30) /// CUSTOMER, AGENT, ASSISTANT, SYSTEM
  senderId               String?              @map("sender_id") @db.Uuid /// External sender ID, null for system
  messageType            String               @default("TEXT") @map("message_type") @db.VarChar(30)
  content                String?              @db.Text
  metadata               Json? /// Payload for SYSTEM messages, e.g. who took over; call or callback references
  replyToMessageId       String?              @map("reply_to_message_id") @db.Uuid /// Must be in the same conversation (composite FK with conversation_id)
  forwardedFromMessageId String?              @map("forwarded_from_message_id") @db.Uuid
  status                 String               @default("SENT") @db.VarChar(20) /// Sender-facing summary: SENDING, SENT, DELIVERED, READ, FAILED. Per-recipient detail is in message_receipts
  isEdited               Boolean              @default(false) @map("is_edited")
  editedAt               DateTime?            @map("edited_at") @db.Timestamptz(6)
  deletedAt              DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedBy              String?              @map("deleted_by") @db.Uuid /// External agents.id
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation           Conversation         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  replyToMessage         Message?             @relation(name: "MessageReplyToMessage", fields: [replyToMessageId, conversationId], references: [id, conversationId], onDelete: Restrict)
  replies                Message[]            @relation("MessageReplyToMessage")
  forwardedFromMessage   Message?             @relation(name: "MessageForwardedFromMessage", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwards               Message[]            @relation("MessageForwardedFromMessage")
  messageReceipts        MessageReceipt[]
  conversationReads      ConversationRead[]
  messageEditHistories   MessageEditHistory[]
  messageReactions       MessageReaction[]
  messageAttachments     MessageAttachment[]
  notifications          Notification[]
  automationLogs         AutomationLog[]
  spamReports            SpamReport[]

  @@unique([conversationId, sequenceNumber])
  @@unique([conversationId, clientId])
  @@unique([id, conversationId], map: "messages_id_conversation_key")
  @@index([conversationId, createdAt])
  @@index([senderType, senderId])
  @@index([replyToMessageId])
  @@index([forwardedFromMessageId])
  @@map("messages")
}

model MessageReceipt {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String    @map("message_id") @db.Uuid
  recipientType String    @map("recipient_type") @db.VarChar(30)
  recipientId   String    @map("recipient_id") @db.Uuid
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientType, recipientId])
  @@index([recipientType, recipientId, readAt])
  @@map("message_receipts")
}

model ConversationRead {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId         String       @map("conversation_id") @db.Uuid
  readerType             String       @map("reader_type") @db.VarChar(30)
  readerId               String       @map("reader_id") @db.Uuid
  lastReadMessageId      String?      @map("last_read_message_id") @db.Uuid
  lastReadSequenceNumber BigInt       @default(0) @map("last_read_sequence_number") /// Unread count = conversations.last_sequence_number - this (approximate: includes own and system messages)
  lastReadAt             DateTime?    @map("last_read_at") @db.Timestamptz(6)
  markedUnread           Boolean      @default(false) @map("marked_unread") /// Agent manually marked the conversation unread (FR-05)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadMessage        Message?     @relation(fields: [lastReadMessageId, conversationId], references: [id, conversationId], onDelete: Restrict)

  @@unique([conversationId, readerType, readerId])
  @@index([lastReadMessageId])
  @@map("conversation_reads")
}

model MessageEditHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String   @map("message_id") @db.Uuid
  editorType      String   @map("editor_type") @db.VarChar(30)
  editorId        String   @map("editor_id") @db.Uuid
  previousContent String   @map("previous_content") @db.Text
  editedAt        DateTime @default(now()) @map("edited_at") @db.Timestamptz(6)
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
  @@map("message_edit_history")
}

model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userType  String   @map("user_type") @db.VarChar(30)
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userType, userId, emoji])
  @@map("message_reactions")
}

model Attachment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId     String              @map("conversation_id") @db.Uuid /// Needed for the Media & Files panel and access control; an upload exists before its message
  uploadedByType     String              @map("uploaded_by_type") @db.VarChar(30)
  uploadedById       String              @map("uploaded_by_id") @db.Uuid
  storageKey         String              @unique @map("storage_key") @db.VarChar(500)
  fileName           String              @map("file_name") @db.VarChar(255)
  mimeType           String              @map("mime_type") @db.VarChar(150)
  fileSize           BigInt              @map("file_size")
  durationMs         Int?                @map("duration_ms") /// Audio, video and voice messages (FR-18)
  waveform           Json? /// Voice message amplitude samples
  checksumSha256     String?             @map("checksum_sha256") @db.VarChar(64)
  uploadStatus       String              @default("PENDING") @map("upload_status") @db.VarChar(30)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  messageAttachments MessageAttachment[]

  @@unique([id, conversationId], map: "attachments_id_conversation_key")
  @@index([conversationId, createdAt])
  @@index([uploadedByType, uploadedById])
  @@index([uploadStatus, createdAt])
  @@map("attachments")
}

model MessageAttachment {
  messageId      String     @map("message_id") @db.Uuid
  attachmentId   String     @map("attachment_id") @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  message        Message    @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  attachment     Attachment @relation(fields: [attachmentId, conversationId], references: [id, conversationId], onDelete: Cascade)

  @@id([messageId, attachmentId])
  @@index([conversationId])
  @@index([attachmentId])
  @@map("message_attachments")
}

model InternalNote {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  authorAgentId  String        @map("author_agent_id") @db.Uuid /// External agents.id
  content        String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  noteMentions   NoteMention[]

  @@index([conversationId, createdAt])
  @@map("internal_notes")
}

model NoteMention {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId           String       @map("note_id") @db.Uuid
  mentionedAgentId String       @map("mentioned_agent_id") @db.Uuid /// External agents.id
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  note             InternalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, mentionedAgentId])
  @@index([mentionedAgentId])
  @@map("note_mentions")
}

model ConversationEscalation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  requestedBy    String       @map("requested_by") @db.Uuid /// External agents.id
  reason         String?      @db.Text
  status         String       @default("PENDING") @db.VarChar(30)
  resolvedBy     String?      @map("resolved_by") @db.Uuid /// External agents.id
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, status])
  @@map("conversation_escalations")
}

model Tag {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String            @unique @db.VarChar(100)
  color            String?           @db.VarChar(30)
  createdBy        String?           @map("created_by") @db.Uuid /// External agents.id
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  conversationTags ConversationTag[]

  @@map("tags")
}

model ConversationTag {
  conversationId String       @map("conversation_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("conversation_tags")
}

model Notification {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientType    String        @map("recipient_type") @db.VarChar(30)
  recipientId      String        @map("recipient_id") @db.Uuid /// External Backend 1 ID
  conversationId   String?       @map("conversation_id") @db.Uuid
  messageId        String?       @map("message_id") @db.Uuid
  notificationType String        @map("notification_type") @db.VarChar(50)
  title            String        @db.VarChar(255)
  body             String?       @db.Text
  readAt           DateTime?     @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message          Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([recipientType, recipientId, createdAt])
  @@index([recipientType, recipientId, readAt])
  @@index([conversationId])
  @@index([messageId])
  @@map("notifications")
}

model NotificationPreference {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId           String   @unique @map("agent_id") @db.Uuid /// External agents.id
  newMessageEnabled Boolean  @default(true) @map("new_message_enabled")
  assignmentEnabled Boolean  @default(true) @map("assignment_enabled")
  transferEnabled   Boolean  @default(true) @map("transfer_enabled")
  mentionEnabled    Boolean  @default(true) @map("mention_enabled")
  soundEnabled      Boolean  @default(true) @map("sound_enabled")
  browserEnabled    Boolean  @default(true) @map("browser_enabled")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

model ConversationNotificationSetting {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  agentId        String       @map("agent_id") @db.Uuid /// External agents.id
  isMuted        Boolean      @default(false) @map("is_muted")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentId])
  @@index([agentId])
  @@map("conversation_notification_settings")
}

/// History only. Live presence (Available/Busy/Away/Offline) is kept in Redis.
model AgentPresenceHistory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String    @map("agent_id") @db.Uuid /// External agents.id
  status    String    @db.VarChar(30) /// AVAILABLE, BUSY, AWAY, OFFLINE
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  @@index([agentId, endedAt])
  @@map("agent_presence_history")
}

model CannedResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @db.VarChar(255)
  content   String   @db.Text
  shortcut  String?  @db.VarChar(50) /// e.g. /greeting
  scope     String   @default("PERSONAL") @db.VarChar(30) /// PERSONAL or TEAM
  teamId    String?  @map("team_id") @db.Uuid /// External team id; set exactly when scope = TEAM (CHECK)
  createdBy String   @map("created_by") @db.Uuid /// External agents.id
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdBy, isActive])
  @@index([teamId, isActive])
  @@map("canned_responses")
}

model AutomationRule {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String          @db.VarChar(255)
  triggerType     String          @map("trigger_type") @db.VarChar(50)
  conditions      Json?
  responseContent String          @map("response_content") @db.Text
  priority        Int             @default(0)
  isActive        Boolean         @default(true) @map("is_active")
  createdBy       String?         @map("created_by") @db.Uuid /// External agents.id
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  automationLogs  AutomationLog[]

  @@index([isActive, triggerType, priority])
  @@map("automation_rules")
}

model AutomationLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  conversationId  String         @map("conversation_id") @db.Uuid
  messageId       String?        @map("message_id") @db.Uuid
  executionStatus String         @map("execution_status") @db.VarChar(30)
  errorMessage    String?        @map("error_message") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rule            AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@index([conversationId])
  @@index([messageId])
  @@map("automation_logs")
}

model CallbackRequest {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid /// External customers.id
  assignedAgentId String?      @map("assigned_agent_id") @db.Uuid /// External agents.id
  createdBy       String?      @map("created_by") @db.Uuid /// External agents.id
  scheduledAt     DateTime     @map("scheduled_at") @db.Timestamptz(6)
  status          String       @default("PENDING") @db.VarChar(30)
  notes           String?      @db.Text
  completionNote  String?      @map("completion_note") @db.Text
  reminderSentAt  DateTime?    @map("reminder_sent_at") @db.Timestamptz(6) /// Set when the upcoming-callback notification was sent
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([assignedAgentId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([conversationId])
  @@index([customerId])
  @@map("callback_requests")
}

/// Signalling record and call history; media is not stored.
model Call {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String            @map("conversation_id") @db.Uuid
  initiatedByType  String            @map("initiated_by_type") @db.VarChar(30)
  initiatedById    String            @map("initiated_by_id") @db.Uuid
  callType         String            @map("call_type") @db.VarChar(20)
  status           String            @default("INITIATING") @db.VarChar(30)
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  callParticipants CallParticipant[]

  @@index([conversationId, createdAt])
  @@map("calls")
}

model CallParticipant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId          String    @map("call_id") @db.Uuid
  participantType String    @map("participant_type") @db.VarChar(30)
  participantId   String    @map("participant_id") @db.Uuid
  joinedAt        DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime? @map("left_at") @db.Timestamptz(6)
  call            Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, participantType, participantId])
  @@index([participantType, participantId])
  @@map("call_participants")
}

model SpamReport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  reportedByType String       @map("reported_by_type") @db.VarChar(30)
  reportedById   String       @map("reported_by_id") @db.Uuid
  messageId      String?      @map("message_id") @db.Uuid /// The reported message, if any
  reason         String       @db.Text
  status         String       @default("PENDING") @db.VarChar(30)
  reviewedBy     String?      @map("reviewed_by") @db.Uuid /// External agents.id
  reviewedAt     DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  resolutionNote String?      @map("resolution_note") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([conversationId])
  @@index([messageId])
  @@map("spam_reports")
}

/// One active block (unblocked_at IS NULL) per customer via a partial unique index.
model CustomerBlock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid /// External customers.id
  blockedBy   String    @map("blocked_by") @db.Uuid /// External agents.id
  reason      String?   @db.Text
  blockedAt   DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(6)
  unblockedAt DateTime? @map("unblocked_at") @db.Timestamptz(6)
  unblockedBy String?   @map("unblocked_by") @db.Uuid /// External agents.id

  @@index([customerId, unblockedAt])
  @@map("customer_blocks")
}

model BlockedKeyword {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyword   String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid /// External agents.id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("blocked_keywords")
}

model ModerationActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid /// External agents.id
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("moderation_activities")
}

model PushDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid /// External users.id (every customer and agent has one)
  platform    String    @db.VarChar(30)
  deviceToken String    @map("device_token") @db.VarChar(512)
  isActive    Boolean   @default(true) @map("is_active")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([platform, deviceToken])
  @@index([userId])
  @@map("push_devices")
}

model WorkspacePreference {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String   @unique @map("agent_id") @db.Uuid /// External agents.id
  layout       Json?
  sidebarWidth Int?     @map("sidebar_width")
  settings     Json?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("workspace_preferences")
}

model WorkspaceOpenConversation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String       @map("agent_id") @db.Uuid /// External agents.id
  conversationId String       @map("conversation_id") @db.Uuid
  sortOrder      Int          @default(0) @map("sort_order")
  lastOpenedAt   DateTime     @default(now()) @map("last_opened_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([agentId, conversationId])
  @@index([conversationId])
  @@map("workspace_open_conversations")
}

model UserChatSetting {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid /// External users.id
  typingSoundEnabled       Boolean  @default(true) @map("typing_sound_enabled")
  notificationSoundEnabled Boolean  @default(true) @map("notification_sound_enabled")
  aiSuggestionsEnabled     Boolean  @default(true) @map("ai_suggestions_enabled")
  aiSummariesEnabled       Boolean  @default(true) @map("ai_summaries_enabled")
  autoAssignEnabled        Boolean  @default(false) @map("auto_assign_enabled") /// Opt in to auto-assignment (only when authorized)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_chat_settings")
}
