// 08. Agent workspace
// Per-person UI state: layout, open tabs, drafts, chat settings.
// Same tables as docs/database/08-agent-workspace.dbml.

model WorkspacePreference {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String   @unique @map("agent_id") @db.Uuid /// External agents.id
  layout       Json?
  sidebarWidth Int?     @map("sidebar_width")
  settings     Json?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("workspace_preferences")
}

model WorkspaceOpenConversation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String       @map("agent_id") @db.Uuid /// External agents.id
  conversationId String       @map("conversation_id") @db.Uuid
  sortOrder      Int          @default(0) @map("sort_order")
  lastOpenedAt   DateTime     @default(now()) @map("last_opened_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([agentId, conversationId])
  @@index([conversationId])
  @@map("workspace_open_conversations")
}

/// An agent's unsent composer text for one conversation (FR-14). Deleted when emptied or sent.
model ConversationDraft {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String       @map("agent_id") @db.Uuid /// External agents.id
  conversationId String       @map("conversation_id") @db.Uuid
  content        String       @db.Text /// At most 10000 characters. An empty draft is deleted, not stored.
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([agentId, conversationId])
  @@index([conversationId])
  @@map("conversation_drafts")
}

model UserChatSetting {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid /// External users.id
  typingSoundEnabled       Boolean  @default(true) @map("typing_sound_enabled")
  notificationSoundEnabled Boolean  @default(true) @map("notification_sound_enabled")
  aiSuggestionsEnabled     Boolean  @default(true) @map("ai_suggestions_enabled")
  aiSummariesEnabled       Boolean  @default(true) @map("ai_summaries_enabled")
  autoAssignEnabled        Boolean  @default(false) @map("auto_assign_enabled") /// Opt in to auto-assignment (only when authorized)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_chat_settings")
}
