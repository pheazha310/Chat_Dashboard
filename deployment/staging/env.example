# STG environment. Copy to /home/ubuntu/chatdash-staging/.env.staging on the server (outside git; `.env*` is git-ignored).
# Replace every CHANGE_ME. Never commit real values.
CHAT_ENV=stg
GIT_BRANCH=staging
# Public origin of the dashboard (one host serves the web, /api and /ws). Domain NOT confirmed: ask the LOS/infra team.
CHAT_PUBLIC_ORIGIN=https://CHANGE_ME-chat-stg-host
# Host ports per slot (127.0.0.1 only). PROPOSED; the scripts refuse to start if one is taken. LOS uses 3000/3001/3010/3011.
# Blue-green slots. PROPOSED. LOS staging uses 3001/3011.
API_PORT_BLUE=4201
WEB_PORT_BLUE=4202
API_PORT_GREEN=4211
WEB_PORT_GREEN=4212

# --- Postgres / Redis (private network, no published ports) ---
POSTGRES_USER=chatdash_stg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chatdash_stg
REDIS_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://chatdash_stg:CHANGE_ME@chatdash-postgres:5432/chatdash_stg?schema=public
REDIS_URL=redis://:CHANGE_ME@chatdash-redis:6379

# --- API ---
NODE_ENV=production
AUTH_MODE=jwt
BACKEND1_MODE=local
EVENT_BUS=redis
TRUST_PROXY=1
LOG_LEVEL=info
CORS_ORIGIN=https://CHANGE_ME-chat-stg-host
CHAT_WEB_ORIGIN=https://CHANGE_ME-chat-stg-host
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# --- LOS (STG) ---
LOS_WEB_ORIGIN=https://cms-uat.delightech.asia
LOS_BASE_URL=https://api-uat.los.delightech.asia/api/v1
# ASK LOS: issuer and JWKS URL (same host as LOS_BASE_URL), audiences, staff role names. See docs/deployment.md.
LOS_ISSUER=CHANGE_ME
LOS_JWKS_URL=CHANGE_ME
LOS_STAFF_ROLE_MAP=

# --- Files: S3-compatible store, STG bucket ---
STORAGE_DRIVER=s3
S3_ENDPOINT=https://CHANGE_ME-s3-compatible-endpoint
S3_BUCKET=CHANGE_ME-chat-stg
S3_REGION=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- Optional deploy notification (same Telegram convention as LOS; leave empty to skip) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
