{
  "name": "chat-dashboard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @chat-dashboard/frontend dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @chat-dashboard/frontend preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "check:fsd": "pnpm -r check:fsd",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:fsd && pnpm format:check && pnpm test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "prettier": "3",
    "prisma": "7.10.1"
  },
  "packageManager": "pnpm@10.34.3",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9"
  }
}
